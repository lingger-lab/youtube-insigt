YT_API_KEY=your_youtube_api_key_here

# 선택: 앱 내 LLM 분석. 비워두면 기능이 꺼지고 버튼이 잠긴다 (클립보드 경로만 동작).
# 서버 전용. NEXT_PUBLIC_ 접두사 금지. 토큰 비용이 든다.
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-opus-5      # 기본값. 스킬 캐시 기준 최신 Opus
# LLM_EFFORT=high              # low | medium | high | xhigh | max

# 선택: 영상 관찰 (Gemini가 공개 YouTube 영상을 직접 보고 훅·구조·썸네일 약속 이행을 기록).
# 비워두면 기능이 꺼지고 버튼이 잠긴다. YouTube URL 입력은 프리뷰 동안 무료, 무료 티어 하루 8시간분.
# 서버 전용. NEXT_PUBLIC_ 접두사 금지. AI Studio(aistudio.google.com)에서 발급.
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-3.8-flash # 기본값. 5분 미만 static / 이상 agentic
